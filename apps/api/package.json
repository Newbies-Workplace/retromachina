{
  "name": "api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "generate": "npx prisma generate && npx prisma format",
    "migrate": "dotenvx run -f ../../.env -- npx prisma migrate dev",
    "migrate:deploy": "dotenvx run -f ../../.env -- npx prisma migrate deploy",
    "studio": "dotenvx run -f ../../.env -- npx prisma studio",
    "test": "node scripts/jest.cjs --runInBand --watchman=false",
    "build": "npm run generate && npm run build:nest",
    "build:nest": "nest build",
    "start": "npx prisma migrate deploy && node dist/src/main",
    "start:prod": "node dist/src/main",
    "start:migrate:prod": "npx prisma migrate deploy && npm run start:prod"
  },
  "dependencies": {
    "@casl/ability": "^6.5.0",
    "@casl/prisma": "^1.4.0",
    "@dotenvx/dotenvx": "^1.5.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/platform-socket.io": "^12.4.0",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.4.0",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.6",
    "dayjs": "^1.11.7",
    "helmet": "^8.3.0",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "shared": "*",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.8.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
