generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
}

model Team {
  id              String   @id @default(uuid())
  name            String
  invite_key      String?  @unique
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt
  organization_id String?
  slug            String   @db.VarChar(100)

  Organization Organization? @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  TeamUser       TeamUsers[]
  Task           Task[]
  Retrospective  Retrospective[]
  Invite         Invite[]
  Board          Board?
  ReflectionCard ReflectionCard[]
  WarmupLink     WarmupLink[]

  @@unique([organization_id, slug])
}

model WarmupLink {
  id          String  @id @default(uuid())
  team_id     String
  name        String
  description String? @db.Text
  url         String  @db.Text

  Team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)
}

model TeamUsers {
  team_id String
  user_id String
  role    Role   @default(USER)

  Team Team? @relation(fields: [team_id], references: [id], onDelete: Cascade)
  User User? @relation(fields: [user_id], references: [id])

  @@unique([team_id, user_id])
}

model Board {
  team_id           String @id
  default_column_id String

  BoardColumns BoardColumn[]
  Tasks        Task[]

  Team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)
}

model BoardColumn {
  id      String @id @default(uuid())
  team_id String
  order   Int
  name    String
  Tasks   Task[]

  Board Board @relation(fields: [team_id], references: [team_id], onDelete: Cascade)
}

model User {
  id          String   @id @default(uuid())
  nick        String
  email       String   @unique
  avatar_link String   @db.Text
  google_id   String   @unique
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  TeamUsers         TeamUsers[]
  Task              Task[]
  Invite            Invite[]
  ReflectionCard    ReflectionCard[]
  OrganizationUsers OrganizationUsers[]
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique @db.VarChar(63)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  Users OrganizationUsers[]
  Teams Team[]
}

model OrganizationUsers {
  organization_id String
  user_id         String
  role            Role   @default(USER)

  Organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  User         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([organization_id, user_id])
  @@index([user_id])
}

model Task {
  id          String   @id @default(uuid())
  description String   @db.Text
  owner_id    String?
  retro_id    String?
  team_id     String
  column_id   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  Board         Board?         @relation(fields: [team_id], references: [team_id], onDelete: Cascade, map: "Task_Board_team_id_fkey")
  User          User?          @relation(fields: [owner_id], references: [id])
  Team          Team?          @relation(fields: [team_id], references: [id], onDelete: Cascade)
  Column        BoardColumn?   @relation(fields: [column_id], references: [id])
  Retrospective Retrospective? @relation(fields: [retro_id], references: [id])
}

model ReflectionCard {
  id      String @id @default(uuid())
  user_id String
  team_id String
  text    String @db.Text

  User User @relation(fields: [user_id], references: [id])
  Team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)
}

model Retrospective {
  id         String   @id @default(uuid())
  team_id    String
  date       DateTime
  is_running Boolean
  room_state Json?

  Team Team? @relation(fields: [team_id], references: [id], onDelete: Cascade)

  Task Task[]
}

model Invite {
  id         String   @id @default(uuid())
  email      String
  team_id    String
  from       String
  role       Role     @default(USER)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  Team Team? @relation(fields: [team_id], references: [id], onDelete: Cascade)
  User User? @relation(fields: [from], references: [id])

  @@unique([team_id, email])
}

enum Role {
  ADMIN
  USER
  OWNER
}
